// initial class diagram
classDiagram
    class Owner {
      +String name
      +String contact
      +String availability
      +String preferences
      +updateInfo()
      +setAvailability()
      +setPreferences()
    }

    class Pet {
      +String name
      +String type
      +int age
      +String specialNeeds
      +updateBasicInfo()
      +addSpecialNeed()
    }

    class Task {
      +String title
      +String type
      +int duration
      +int priority
      +String frequency
      +String notes
      +updateTask()
      +setDuration()
      +setPriority()
      +setFrequency()
    }

    class Scheduler {
      +List~Task~ tasks
      +Owner owner
      +List~Pet~ pets
      +generateDailyPlan()
      +viewPlan()
      +editPlan()
      +filterByDuration()
      +filterByPriority()
    }

    Owner "1" o-- "0..*" Pet : owns
    Owner "1" o-- "0..*" Task : manages
    Scheduler "1" o-- "0..*" Task : schedules
    Scheduler "1" o-- "0..*" Pet : includes
    Scheduler "1" o-- "1" Owner : uses
    